{
  "manifest_version": 3,
  "name": "Linux Download Manager Bridge",
  "version": "0.2.5",
  "description": "Sends links from Firefox to Linux Download Manager.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ldm-bridge@ekremx25.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    }
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "cookies",
    "downloads",
    "nativeMessaging",
    "storage",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "css": ["content-style.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.molystream.org/*", "https://*.hotstream.club/*", "https://*.rapidvid.org/*"],
      "js": ["player-manifest-observer.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["youtube-audio-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Linux Download Manager",
    "default_popup": "popup.html"
  }
}
