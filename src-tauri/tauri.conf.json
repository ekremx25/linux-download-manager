{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux Download Manager Custom",
  "version": "0.2.5",
  "identifier": "com.eko.linuxdownloadmanagercustom",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Linux Download Manager",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 580,
        "resizable": true,
        "visible": false
      },
      {
        "label": "add-download",
        "title": "Add download",
        "url": "add-download.html",
        "width": 620,
        "height": 720,
        "resizable": true,
        "visible": false,
        "minWidth": 480,
        "minHeight": 460
      },
      {
        "label": "download-detail",
        "title": "Download details",
        "url": "download-detail.html",
        "width": 1100,
        "height": 820,
        "resizable": true,
        "visible": false,
        "minWidth": 520,
        "minHeight": 460,
        "maximized": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/icon.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "resources": [
      "icons/icon.png",
      "../browser/chromium/",
      "../browser/firefox/manifest.json"
    ],
    "linux": {
      "appimage": {
        "files": {
          "usr/bin/browser_native_host": "../target/release/browser_native_host"
        }
      }
    }
  }
}
