{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux Download Manager Custom",
  "version": "0.2.0",
  "identifier": "com.eko.linuxdownloadmanagercustom",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Linux Download Manager Custom",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "visible": false
      },
      {
        "label": "add-download",
        "title": "Add Download",
        "url": "add-download.html",
        "width": 560,
        "height": 340,
        "resizable": false,
        "visible": false
      },
      {
        "label": "download-detail",
        "title": "Download Details",
        "url": "download-detail.html",
        "width": 640,
        "height": 460,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/icon.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "resources": [
      "icons/icon.png"
    ]
  }
}
